[Unit]
Description=Optics HTTPS
After=network-online.target position-lens.service
Wants=network-online.target
RequiresMountsFor=/srv/position-lens-data
[Service]
User=caddy
Group=caddy
Environment=HOME=/srv/position-lens-data/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/position-lens-data/caddy
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
